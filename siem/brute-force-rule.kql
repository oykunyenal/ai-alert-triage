// Microsoft Sentinel analytics rule: SSH brute-force attempt
// 5 or more failed logins from the same source IP within 5 minutes.
Syslog
| where Facility in ("auth", "authpriv")
| where SyslogMessage has "Failed password"
| extend SrcIp = extract(@"from (\d{1,3}(?:\.\d{1,3}){3})", 1, SyslogMessage),
         TargetUser = extract(@"for (?:invalid user )?(\S+) from", 1, SyslogMessage)
| summarize Attempts = count(),
            Users = make_set(TargetUser, 20),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
          by Computer, SrcIp
| where Attempts >= 5
