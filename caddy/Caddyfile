# Caddy obtains and renews the Let's Encrypt certificate automatically.
{$DOMAIN} {
	# Alertmanager reaches n8n over the internal network (http://n8n:5678).
	# The alert webhook never needs to be called from the internet, so it is blocked.
	handle /webhook/alerts* {
		respond "Forbidden" 403
	}
	handle /grafana* {
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy n8n:5678
	}
}
